@model WebApp.Models.Product

@{
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
    ViewData["Title"] = "Product Details";
}

<div class="row">

    <div class="col-md-8">

        <div class="card shadow-sm">

            <div class="card-header">
                <h4 class="mb-0">Product Details</h4>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrEmpty(Model.ImgURL))
                {
                    <div class="mb-4">

                        <img src="@Model.ImgURL"
                             width="180"
                             height="180"
                             style="object-fit: cover;" />

                    </div>
                }

                <dl class="row">

                    <dt class="col-sm-3">
                        Id
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Id
                    </dd>

                    <dt class="col-sm-3">
                        Name
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Name
                    </dd>

                    <dt class="col-sm-3">
                        Description
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Description
                    </dd>

                    <dt class="col-sm-3">
                        Price
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Price.ToString("N0")
                    </dd>

                    <dt class="col-sm-3">
                        Quantity
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Quantity
                    </dd>

                    <dt class="col-sm-3">
                        Category
                    </dt>

                    <dd class="col-sm-9">
                        @Model.Category?.Name
                    </dd>

                    <dt class="col-sm-3">
                        Status
                    </dt>

                    <dd class="col-sm-9">
                        @(Model.Status ? "Active" : "Inactive")
                    </dd>

                </dl>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>

            </div>
        </div>

    </div>
</div>