@model List<WebApp.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="row">

    <div class="col-lg-12">

        <h1 class="page-header">
            Orders
        </h1>

    </div>

</div>

<div class="panel panel-default">

    <div class="panel-heading">
        Danh sách đơn hàng
    </div>

    <div class="panel-body">

        <div class="table-responsive">

            <table class="table table-striped table-bordered">

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var order in Model)
                    {
                        <tr>

                            <td>
                                @order.Id
                            </td>

                            <td>
                                @order.CustomerName
                            </td>

                            <td>
                                @order.Phone
                            </td>

                            <td>
                                @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @order.TotalAmount.ToString("N0") VNĐ
                            </td>

                            <td>
                                @order.Status
                            </td>

                            <td>

                                <a asp-controller="Admin"
                                   asp-action="OrderDetails"
                                   asp-route-id="@order.Id"
                                   class="btn btn-primary btn-sm">

                                    <i class="fa fa-eye"></i>
                                    Chi tiết

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>  