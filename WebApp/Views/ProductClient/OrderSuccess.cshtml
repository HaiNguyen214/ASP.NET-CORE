@model WebApp.Models.Order

@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container"
     style="padding-top:150px; padding-bottom:100px;">

    <div class="row">

        <div class="col-12">

            <div class="text-center">

                <i class="fa fa-check-circle"
                   style="font-size:80px; color:#28a745;">
                </i>

                <h2 style="margin-top:25px;">
                    Đặt hàng thành công!
                </h2>

                <p style="margin-top:15px;">
                    Cảm ơn bạn đã mua hàng.
                </p>

                <div class="mt-4">

                    <p>
                        Mã đơn hàng:
                        <strong>
                            #@Model.Id
                        </strong>
                    </p>

                    <p>
                        Khách hàng:
                        <strong>
                            @Model.CustomerName
                        </strong>
                    </p>

                    <p>
                        Số điện thoại:
                        <strong>
                            @Model.Phone
                        </strong>
                    </p>

                    <p>
                        Tổng tiền:
                        <strong>
                            @Model.TotalAmount.ToString("N0") VNĐ
                        </strong>
                    </p>

                    <p>
                        Trạng thái:
                        <strong>
                            @Model.Status
                        </strong>
                    </p>

                </div>

                <div style="margin-top:30px;">

                    <a href="/ProductClient/Shop"
                       class="btn btn-primary">
                        TIẾP TỤC MUA HÀNG
                    </a>

                    <a href="/ProductClient/Cart"
                       class="btn btn-secondary">
                        GIỎ HÀNG
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>